# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here

# Error Reporting Channel (optional)
ERROR_REPORT_GUILD_ID=your_error_report_guild_id
ERROR_REPORT_CHANNEL_ID=your_error_report_channel_id

# Creator Check (user IDs allowed to use admin commands)
DISCORD_CREATOR_CHECK=interaction.user.id === 'your_user_id'

# Build Configuration
BUILD_COMMANDS=false

# Runtime
NODE_ENV=production
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=
